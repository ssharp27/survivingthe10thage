; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="survivingthe10thage"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas"

[dotnet]

project/assembly_name="survivingthe10thage"

[editor_plugins]

required_editor_plugins=PackedStringArray("res://addons/godot_mcp/Editor/GodotMcpPlugin.cs")
enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

