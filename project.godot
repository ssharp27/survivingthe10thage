window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="survivingthe10thage"

[editor_plugins]

required_editor_plugins=PackedStringArray("res://addons/godot_mcp/Editor/GodotMcpPlugin.cs")
